# ── Dockerfile.test ───────────────────────────────────────────
# Selenium headless Chrome test runner for Multi-Tenant Daraz Clone
# Uses modern Chrome installation (post Debian-12 apt-key removal)
# and the Chrome-for-Testing endpoint for matching ChromeDriver.
# ──────────────────────────────────────────────────────────────

FROM python:3.11-slim

LABEL maintainer="saira@comsats.edu.pk"
LABEL description="Selenium headless Chrome test runner for Multi-Tenant Daraz Clone"

ENV DEBIAN_FRONTEND=noninteractive

# ── System dependencies for Chrome ─────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget curl gnupg unzip ca-certificates \
        fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 \
        libcups2 libdbus-1-3 libdrm2 libgbm1 libnspr4 libnss3 \
        libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 \
        xdg-utils libu2f-udev libvulkan1 \
    && rm -rf /var/lib/apt/lists/*

# ── Install Google Chrome (modern way: direct .deb, no apt-key) ─
RUN wget -q -O /tmp/chrome.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/chrome.deb \
    && rm /tmp/chrome.deb \
    && rm -rf /var/lib/apt/lists/* \
    && google-chrome --version

# ── Install matching ChromeDriver via Chrome for Testing ───────
RUN DRIVER_URL=$(curl -s https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json \
        | python3 -c "import sys, json; d=json.load(sys.stdin); \
print([x['url'] for x in d['channels']['Stable']['downloads']['chromedriver'] if x['platform']=='linux64'][0])") \
    && echo "Downloading $DRIVER_URL" \
    && wget -q -O /tmp/cd.zip "$DRIVER_URL" \
    && unzip -j /tmp/cd.zip "*/chromedriver" -d /usr/bin/ \
    && chmod +x /usr/bin/chromedriver \
    && rm /tmp/cd.zip \
    && chromedriver --version

WORKDIR /app

# ── Python dependencies ────────────────────────────────────────
COPY tests/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Test sources ───────────────────────────────────────────────
COPY tests/ ./tests/
COPY pytest.ini .

# ── Default command: run all tests, generate HTML report ──────
CMD ["pytest", "tests/test_daraz.py", "-v", \
     "--html=tests/test-report.html", \
     "--self-contained-html"]
